# Network
NETWORK=testnet
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Monad RPC endpoint (for staking precompile queries)
MONAD_RPC_URL=http://127.0.0.1:8080

# Sync intervals
# STATUS_SYNC_INTERVAL_MS=3600000    # Staking data sync (default: 1 hour)
# METADATA_SYNC_INTERVAL_MS=3600000  # GitHub metadata sync (default: 1 hour)
# EPOCH_POLL_MS=120000               # Epoch watcher poll interval (default: 2 min)
