# Network
NETWORK=testnet
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

# Monad RPC endpoint (for staking precompile queries)
MONAD_RPC_URL=http://127.0.0.1:8080

# Sync intervals
# STATUS_SYNC_INTERVAL_MS=3600000    # Staking data sync (default: 1 hour)
# METADATA_SYNC_INTERVAL_MS=3600000  # GitHub metadata sync (default: 1 hour)
# EPOCH_POLL_MS=120000               # Epoch watcher poll interval (default: 2 min)

# Uptime
# UPTIME_RETENTION_HOURS=48          # Raw event retention (default: 48 hours)

# Staking event indexer
# EVENT_INDEXER_POLL_MS=30000        # Poll interval (default: 30s)
# EVENT_INDEXER_CHUNK=1000           # Blocks per getLogs call (default: 1000)
# EVENT_INDEXER_CONFIRMATIONS=10     # Blocks to stay behind the head (default: 10)
# EVENT_INDEXER_START_BLOCK=         # Backfill from this block on first run
#                                    # (default: start at the current head)
# ARCHIVE_RPC_URL=https://rpc1.monad.xyz  # Archive for npm run backfill
# EVENT_INDEXER_EDGE_MARGIN=10000    # After the node's history runs out, resume this far
#                                    # above its oldest block (default: 10000)

# Reverse proxy
# TRUST_PROXY=loopback               # which hops to trust for X-Forwarded-For
#                                    # (default: loopback — correct behind local nginx)
