# ===============================
# 📦 Snapshot Server (Monad Testnet-2)
# ===============================
server {
    if ($host = snapshot.huginn.tech) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name snapshot.huginn.tech;
    
    # Let's Encrypt için
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }
    
    # HTTPS'e yönlendir
    location / {
        return 301 https://$server_name$request_uri;
    }


}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name snapshot.huginn.tech;
    
    # SSL sertifikaları (Caddy'den kopyala)
    ssl_certificate /etc/letsencrypt/live/snapshot.huginn.tech/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/snapshot.huginn.tech/privkey.pem; # managed by Certbot
    
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    
    # Snapshot servisi
    location /monad/testnet/ {
        alias /opt/public-snap/monad/testnet/;
        
        # 🔥 SYMLİNK DESTEĞİ (Nginx varsayılan olarak destekler!)
        disable_symlinks off;
        
        autoindex on;
        autoindex_exact_size off;
        autoindex_localtime on;
        
        gzip on;
        gzip_types text/plain application/octet-stream;
        
        # Headers
        add_header Access-Control-Allow-Origin "*" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cache-Control "public, max-age=30" always;
    }
    
    access_log /var/log/nginx/snapshot.log;
    error_log /var/log/nginx/snapshot-error.log;

}

# ===============================
# 🌐 RPC Server
# ===============================
server {
    if ($host = monad-testnet-rpc.huginn.tech) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name monad-testnet-rpc.huginn.tech;
    
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }
    
    location / {
        return 301 https://$server_name$request_uri;
    }


}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name monad-testnet-rpc.huginn.tech;
    ssl_certificate /etc/letsencrypt/live/snapshot.huginn.tech/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/snapshot.huginn.tech/privkey.pem; # managed by Certbot

    
    location / {
        proxy_pass http://0.0.0.0:8080;
        proxy_http_version 1.1;
        
        # CORS Headers
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "*" always;
        
        if ($request_method = 'OPTIONS') {
            return 204;
        }
    }
    
    access_log /var/log/nginx/monad-rpc.log;

}

# ===============================
# 🔌 WebSocket RPC Server (WSS)
# ===============================
server {
    if ($host = wss.monad-testnet-rpc.huginn.tech) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name wss.monad-testnet-rpc.huginn.tech;
    
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }
    
    location / {
        return 301 https://$server_name$request_uri;
    }


}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name wss.monad-testnet-rpc.huginn.tech;
    ssl_certificate /etc/letsencrypt/live/snapshot.huginn.tech/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/snapshot.huginn.tech/privkey.pem; # managed by Certbot

    
    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        
        # WebSocket support
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        
        # CORS Headers
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "*" always;
    }
    
    access_log /var/log/nginx/monad-wss.log;

}
